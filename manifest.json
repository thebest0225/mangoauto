{
  "manifest_version": 3,
  "name": "MangoAuto",
  "version": "1.9.1",
  "description": "Grok/Flow 영상 자동화 + 네이버 블로그 초안 채우기 (MangoHub 연동)",
  "permissions": [
    "cookies",
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "activeTab",
    "sidePanel",
    "clipboardWrite",
    "clipboardRead",
    "debugger"
  ],
  "host_permissions": [
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://imagine-public.x.ai/*",
    "https://labs.google/*",
    "https://*.googleapis.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.mangois.love/*",
    "https://api.kie.ai/*",
    "https://blog.naver.com/*",
    "https://*.naver.com/*",
    "https://*.aiquickdraw.com/*",
    "https://oguonline.com/*",
    "https://*.oguonline.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://grok.com/*"],
      "js": ["content/grok_dedupe.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://grok.com/*"],
      "js": ["lib/utils.js", "content/shared-dom.js", "content/grok.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/video-fx*",
        "https://labs.google/fx/*/tools/video-fx*"
      ],
      "js": ["lib/utils.js", "content/shared-dom.js", "content/flow.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": ["lib/utils.js", "content/shared-dom.js", "content/flow.js"],
      "run_at": "document_idle"
    },
    {
      "//": "네이버 글쓰기. SmartEditor 는 #mainFrame iframe 안에서 돌기 때문에 all_frames 필수.",
      "matches": [
        "https://blog.naver.com/*"
      ],
      "js": ["content/naver.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/inject.js"],
      "matches": ["https://labs.google/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
